# ═══════════════════════════════════════════════════════════
# 🔒 KEAMANAN & RAHASIA (JANGAN PERNAH DI-COMMIT)
# ═══════════════════════════════════════════════════════════

# Environment & Secrets
.env*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.secret

# Lembaran Vault (Database Terenkripsi)
.lembaran/
.lembaran-db.json
*.lembaran

# Credentials & Tokens
credentials.json
tokens.json
*.token
*.credentials

# ═══════════════════════════════════════════════════════════
# 🏗️ BUILD ARTIFACTS (HASIL KOMPILASI)
# ═══════════════════════════════════════════════════════════

# Next.js (Web)
.next/
out/
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Bun
bun.lockb
!bun.lock

# ═══════════════════════════════════════════════════════════
