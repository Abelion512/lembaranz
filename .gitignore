# ═══════════════════════════════════════════════════════════
# 📦 PUBLIKASI & PACKAGES
# ═══════════════════════════════════════════════════════════

# CLI Build Artifacts
packages/cli/dist/
packages/cli/*.exe
packages/cli/*.bin

# NPM Package (jika publish)
*.tgz
*.tar.gz

# NPM Cache lokal (jangan commit)
.npm-cache/
.npm-update-notifier*
.npm_update*

# ═══════════════════════════════════════════════════════════
# ✅ YANG HARUS DI-COMMIT (PUBLIK)
# ═══════════════════════════════════════════════════════════

# ✅ Source Code
# *.ts
# *.tsx
# *.js
# *.jsx
# *.css
# *.json

# ✅ Dokumentasi
# docs/*.md
# README.md
# CHANGELOG.md
# PRD.md
# CONTRIBUTING.md
# SECURITY.md

# ✅ Konfigurasi
# package.json
# tsconfig.json
# next.config.ts
# eslint.config.mjs
# .github/

# ✅ Scripts
# scripts/*.ts
# scripts/*.sh

# ✅ Git Hooks
# .githooks/
# .git/hooks/ (auto-generated)

# ═══════════════════════════════════════════════════════════
# 📝 CATATAN
# ═══════════════════════════════════════════════════════════

# File yang TIDAK ada di .gitignore akan otomatis TER-TRACK
# Jadi tidak perlu explicit include di sini.

# Jika butuh commit file yang di-ignore:
# git add -f <filename>

# Untuk cek file yang di-ignore:
# git check-ignore -v <filename>

