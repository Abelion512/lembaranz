{
  "name": "@lembaranz/core",
  "version": "1.0.1",
  "description": "Core encryption engine for Lembaranz — AES-GCM 256 + Argon2id, local-first, zero-knowledge note vault.",
  "author": "Abelion Lavv <agen.salva@gmail.com>",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lembaranz",
    "encryption",
    "aes-gcm",
    "argon2id",
    "vault",
    "local-first",
    "zero-knowledge",
    "notes",
    "privacy",
    "secure"
  ],
  "homepage": "https://github.com/Abelion512/lembaranz#readme",
  "bugs": {
    "url": "https://github.com/Abelion512/lembaranz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelion512/lembaranz.git"
  },
  "type": "module",
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "browser": {
    "./src/storage/FileAdapter.ts": "./src/storage/FileAdapter.shim.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "bun test src/__tests__/",
    "test:coverage": "bun test --coverage src/__tests__/"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "idb": "^8.0.3",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11",
    "react": "19.2.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "@types/react": "^19"
  }
}
