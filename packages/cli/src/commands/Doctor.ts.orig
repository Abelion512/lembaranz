import { Command } from "commander";
import fs from "node:fs/promises";
import path from "node:path";

/**
 * Shannon Entropy calculation to detect random-looking strings (secrets)
 */
function calculateEntropy(str: string): number {
  const len = str.length;
  const frequencies: Record<string, number> = {};
  for (let i = 0; i < len; i++) {
    const char = str[i];
    frequencies[char] = (frequencies[char] || 0) + 1;
  }
  return Object.values(frequencies).reduce((sum, freq) => {
    const p = freq / len;
    return sum - p * Math.log2(p);
  }, 0);
}

const IGNORE_DIRS = ["node_modules", ".git", "dist", "build", "target", ".lembaranz"];
const SCAN_EXTENSIONS = [".env", ".txt", ".md", ".js", ".ts", ".json", ".yaml", ".yml", ".sh"];
const SECRET_REGEX = /(?:sh-|sk-|gh_|AI_|AIza|AWS_)[a-zA-Z0-9_\-]{16,}/g;

export function registerDoctorCommand(program: Command) {
  program
    .command("doctor")
    .description("Advanced security audit: entropy scan, leak detection, and git safety")
    .option("--fix", "Attempt to automatically fix detected issues")
    .option("--deep", "Deep scan file contents for high-entropy secrets")
    .action(async (options) => {
      console.log("🩺 Lembaranz Sentinel: Running advanced diagnostics...\n");

      const issues: any[] = [];
      const cwd = process.cwd();

      // 1. Git Safety Check
      try {
        const gitignorePath = path.join(cwd, ".gitignore");
        const gitContent = await fs.readFile(gitignorePath, "utf8");

        [".env", "db/data.sqlite", ".lembaranz"].forEach(item => {
           if (!gitContent.includes(item)) {
             issues.push({
               id: `leak_${item}`,
               msg: `${item} not protected by .gitignore`,
               severity: "CRITICAL",
               fix: async () => {
                 await fs.appendFile(gitignorePath, `\n# Lembaranz Safety\n${item}\n`);
                 return `Added ${item} to .gitignore`;
               }
             });
           }
        });
      } catch {
        issues.push({ id: "no_gitignore", msg: ".gitignore missing", severity: "HIGH" });
      }

      // 2. Entropy & Pattern Scan
      if (options.deep) {
        console.log("🔍 Deep Scan active. Analyzing file contents (Entropy + Patterns)...");

        async function walk(dir: string) {
          const entries = await fs.readdir(dir, { withFileTypes: true });
          for (const entry of entries) {
            const fullPath = path.join(dir, entry.name);
            const relativePath = path.relative(cwd, fullPath);

            if (entry.isDirectory()) {
              if (IGNORE_DIRS.includes(entry.name)) continue;
              await walk(fullPath);
            } else {
              if (!SCAN_EXTENSIONS.includes(path.extname(entry.name))) continue;

              try {
                const content = await fs.readFile(fullPath, "utf8");

                // Pattern match
                const matches = content.match(SECRET_REGEX);
                if (matches) {
                  issues.push({
                    id: "pattern_match",
                    msg: `Known secret pattern found in ${relativePath} (${matches.length} hits)`,
                    severity: "CRITICAL"
                  });
                }

                // Entropy scan (long words)
                const words = content.split(/\s+/);
                for (const word of words) {
                  if (word.length > 24 && calculateEntropy(word) > 4.2) {
                    issues.push({
                      id: "entropy_hit",
                      msg: `High-entropy string detected in ${relativePath} (Potential key/token)`,
                      severity: "HIGH"
                    });
                    break;
                  }
                }
              } catch {}
            }
          }
        }
        await walk(cwd);
      } else {
        // Filename based check (fast)
        const files = await fs.readdir(cwd);
        const secretFiles = files.filter(f => f.includes("key") || f.includes("secret") || f.includes("vault") || f.endsWith(".json"));
        for (const f of secretFiles) {
           if (["package.json", "package-lock.json", "bun.lock", "tsconfig.json"].includes(f)) continue;
           issues.push({ id: "exposed_file", msg: `Exposed potential secret file: ${f}`, severity: "MEDIUM" });
        }
      }

      if (issues.length === 0) {
        console.log("✅ All systems healthy. No leaks or exposed keys detected.");
        return;
      }

      for (const issue of issues) {
        console.log(`[${issue.severity}] ${issue.msg}`);
        if (options.fix && issue.fix) {
          const result = await issue.fix();
          console.log(`   └─ Fixed: ${result}`);
        }
      }

      if (!options.fix) {
        console.log("\n💡 Suggestion: Run 'lembaranz doctor --fix' or use '--deep' for content analysis.");
      }
    });
}
