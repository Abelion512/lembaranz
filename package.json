{
  "name": "lembaranz",
  "version": "0.0.0",
  "description": "Lembaranz - Personal Digital Archive Vault with zero-knowledge encryption",
  "workspaces": [
    "packages/*"
  ],
  "author": "Abelion Lavv <agen.salva@gmail.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelion512/lembaranz.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/Abelion512/lembaranz#readme",
  "bugs": {
    "url": "https://github.com/Abelion512/lembaranz/issues"
  },
  "files": [
    "packages/",
    "!packages/*/node_modules",
    "!packages/*/dist",
    "!packages/*/.next",
    "docs/*.md",
    "docs/en/",
    "docs/id/",
    "!docs/arsip",
    "scripts/",
    ".github/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "compose.yaml",
    "Dockerfile",
    ".env.example"
  ],
  "keywords": [
    "lembaranz",
    "notes",
    "vault",
    "encrypted",
    "privacy",
    "local-first",
    "zero-knowledge",
    "encryption",
    "aes-gcm",
    "argon2id",
    "cli",
    "tui",
    "secure",
    "archive"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "cli": "bun ./packages/cli/src/main.ts",
    "lint": "eslint .",
    "security-audit": "bun ./scripts/security-audit.ts",
    "prepublishOnly": "bun run security-audit",
    "test": "bun test ./packages/core/src/__tests__/",
    "test:core": "bun test ./packages/core/src/__tests__/",
    "test:perf": "bun ./packages/core/src/scripts/inject-perf-data.ts",
    "version-packages": "changeset version",
    "ci:release": "bun run security-audit && changeset publish",
    "clean": "rm -rf node_modules"
  },
  "bin": {
    "lembaranz": "./packages/cli/src/main.ts"
  },
  "dependencies": {
    "@abelionorg/tagger-public": "^1.0.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "commander": "^14.0.3",
    "dompurify": "^3.4.7",
    "idb": "^8.0.3",
    "ink": "^7.0.5",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.4",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "19.2.6",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/marked": "^6.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.15",
    "bun-types": "^1.3.14",
    "eslint": "^10.4.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
