{
  "name": "lembaran",
  "version": "1.0.0",
  "description": "Lembaran - Personal Digital Archive Vault with zero-knowledge encryption",
  "author": "Abelion Lavv <agen.salva@gmail.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelion512/lembaran.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/Abelion512/lembaran#readme",
  "bugs": {
    "url": "https://github.com/Abelion512/lembaran/issues"
  },
  "keywords": [
    "lembaran",
    "notes",
    "vault",
    "encrypted",
    "privacy",
    "local-first",
    "zero-knowledge",
    "encryption",
    "aes-gcm",
    "argon2id",
    "cli",
    "tui",
    "secure",
    "archive"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun --filter @lembaranz/cli start",
    "lint": "bun --filter \"*\" lint",
    "test": "bun --filter @lembaranz/core test",
    "test:core": "bun --filter @lembaranz/core test",
    "test:perf": "bun packages/core/src/scripts/inject-perf-data.ts",
    "version-packages": "changeset version",
    "ci:release": "changeset publish",
    "clean": "rm -rf node_modules .next"
  },
  "bin": {
    "lembaran": "./packages/cli/src/main.ts"
  },
  "dependencies": {
    "@abelionorg/tagger-public": "^1.0.2",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/prompts": "^2.4.9",
    "eslint": "^9",
    "next": "16.1.7",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0"
  }
}
