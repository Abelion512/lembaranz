{
  "name": "lembaranz",
  "version": "0.0.0",
  "description": "Lembaranz - Personal Digital Archive Vault with zero-knowledge encryption",
  "workspaces": [
    "packages/*"
  ],
  "author": "Abelion Lavv <agen.salva@gmail.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelion512/lembaranz.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/Abelion512/lembaranz#readme",
  "bugs": {
    "url": "https://github.com/Abelion512/lembaranz/issues"
  },
  "files": [
    "packages/",
    "!packages/*/node_modules",
    "!packages/*/dist",
    "!packages/*/.next",
    "docs/*.md",
    "docs/en/",
    "docs/id/",
    "!docs/arsip",
    "scripts/",
    ".github/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "compose.yaml",
    "Dockerfile",
    ".env.example"
  ],
  "keywords": [
    "lembaranz",
    "notes",
    "vault",
    "encrypted",
    "privacy",
    "local-first",
    "zero-knowledge",
    "encryption",
    "aes-gcm",
    "argon2id",
    "cli",
    "tui",
    "secure",
    "archive"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "cli": "bun ./packages/cli/src/main.ts",
    "lint": "eslint .",
    "lint:design": "impeccable detect packages/dashboard/src",
    "security-audit": "bun ./scripts/security-audit.ts",
    "prepublishOnly": "bun run security-audit",
    "test": "bun run test:core && bun run test:cli && bun run test:server && bun run test:dashboard",
    "test:core": "bun test ./packages/core/src/__tests__/",
    "test:cli": "bun test ./packages/cli/src/__tests__/ ./packages/cli/src/commands/__tests__/ ./packages/cli/src/tui/__tests__/",
    "test:dashboard": "bun run --cwd packages/dashboard test",
    "test:perf": "bun ./packages/core/src/scripts/inject-perf-data.ts",
    "test:coverage": "bun run test:coverage:core && bun run test:coverage:cli && bun run test:coverage:server && bun run test:coverage:dashboard",
    "test:coverage:core": "bun scripts/coverage-gate.ts --label core --floor 73 -- bun test --coverage ./packages/core/src/__tests__/",
    "test:coverage:cli": "bun scripts/coverage-gate.ts --label cli --row All files --floor 30 -- bun test --coverage ./packages/cli/src/__tests__/ ./packages/cli/src/commands/__tests__/ ./packages/cli/src/tui/__tests__/",
    "test:coverage:server": "bun scripts/coverage-gate.ts --label server --row packages/server --floor 84 -- bun test --coverage ./packages/server/src/__tests__/",
    "test:coverage:dashboard": "bun run --cwd packages/dashboard test:coverage",
    "build": "bun run --cwd packages/dashboard build",
    "version-packages": "changeset version",
    "ci:release": "bun run security-audit && changeset publish",
    "clean": "rm -rf node_modules",
    "test:server": "bun test ./packages/server/src/__tests__/",
    "typecheck:core": "bunx tsc --noEmit --project packages/core/tsconfig.json",
    "typecheck:cli": "bunx tsc --noEmit --project packages/cli/tsconfig.json",
    "typecheck:server": "bunx tsc --noEmit --project packages/server/tsconfig.json",
    "typecheck:dashboard": "bun run --cwd packages/dashboard typecheck",
    "verify:render": "bun packages/dashboard/scripts/verify-render.tsx",
    "verify": "bun scripts/verify.ts"
  },
  "bin": {
    "lembaranz": "./packages/cli/src/main.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "commander": "^15.0.0",
    "idb": "^8.0.3",
    "ink": "^7.0.5",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "19.2.8",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "bun-types": "^1.3.14",
    "eslint": "^10.4.1",
    "impeccable": "^4.1.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
