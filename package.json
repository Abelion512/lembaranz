{
  "name": "lembaranz",
  "version": "1.0.1",
  "description": "Lembaranz - Personal Digital Archive Vault with zero-knowledge encryption",
  "workspaces": [
    "packages/*"
  ],
  "author": "Abelion Lavv <agen.salva@gmail.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelion512/lembaranz.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/Abelion512/lembaranz#readme",
  "bugs": {
    "url": "https://github.com/Abelion512/lembaranz/issues"
  },
  "files": [
    "packages/",
    "!packages/*/node_modules",
    "!packages/*/dist",
    "!packages/*/.next",
    "docs/*.md",
    "docs/en/",
    "docs/id/",
    "!docs/arsip",
    "scripts/",
    ".github/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "compose.yaml",
    "Dockerfile",
    ".env.example"
  ],
  "keywords": [
    "lembaranz",
    "notes",
    "vault",
    "encrypted",
    "privacy",
    "local-first",
    "zero-knowledge",
    "encryption",
    "aes-gcm",
    "argon2id",
    "cli",
    "tui",
    "secure",
    "archive"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "planned:dev": "bun --cwd web dev",
    "planned:build": "bun --cwd web build",
    "cli": "bun ./packages/cli/src/main.ts",
    "lint": "eslint .",
    "test": "bun test ./packages/core/src/__tests__/",
    "test:core": "bun test ./packages/core/src/__tests__/",
    "test:perf": "bun ./packages/core/src/scripts/inject-perf-data.ts",
    "version-packages": "changeset version",
    "ci:release": "changeset publish",
    "clean": "rm -rf node_modules .next"
  },
  "bin": {
    "lembaranz": "./packages/cli/src/main.ts"
  },
  "dependencies": {
    "@abelionorg/tagger-public": "^1.0.2",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "commander": "^14.0.3",
    "idb": "^8.0.3",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "bun-types": "^1.3.12",
    "eslint": "^9.39.4",
    "next": "^16.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
