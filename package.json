{
  "name": "lembaran",
  "version": "3.4.0",
  "description": "Lembaran - Brankas Aksara Personal yang Berdikari",
  "author": "Abelion Lavv <agen.salva@gmail.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelion512/lembaran.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/Abelion512/lembaran#readme",
  "bugs": {
    "url": "https://github.com/Abelion512/lembaran/issues"
  },
  "keywords": [
    "lembaran",
    "notes",
    "vault",
    "encrypted",
    "privacy",
    "local-first",
    "indonesia",
    "zero-knowledge"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "lembaran": "./packages/cli/src/main.ts"
  },
  "scripts": {
    "dev": "bun --filter @lembaran/web dev",
    "build": "bun --filter @lembaran/web build",
    "start": "bun --filter @lembaran/web start",
    "cli": "bun --filter @lembaran/cli start",
    "lint": "bun --filter \"*\" lint",
    "test:perf": "bun packages/core/src/scripts/inject-perf-data.ts",
    "sinkron-aset": "bun --filter @lembaran/web sinkron-aset"
  },
  "dependencies": {
    "@abelion/tagger-public": "^1.1.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/prompts": "^2.4.9",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0"
  }
}
