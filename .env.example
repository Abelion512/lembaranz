# Lembaranz Environment Variables Example
# Salin file ini ke .env untuk konfigurasi lokal

# App
NEXT_PUBLIC_APP_URL=http://localhost:1400

# Keamanan (Aksara)
# Gunakan kunci yang kuat untuk enkripsi cadangan jika diperlukan
KUNCI_RAHASIA=ganti-dengan-kunci-anda

# AI (Suara)
# Opsional: Jika ingin menggunakan fitur asisten di CLI atau Web
GEMINI_API_KEY=your-api-key-here

# Database (Jiwa)
# Lembaranz menggunakan SQLite/Lokal secara default
DATABASE_URL=file:./dev.db
